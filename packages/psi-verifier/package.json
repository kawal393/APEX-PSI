{
  "name": "apex-psi-verifier",
  "version": "1.4.0",
  "description": "MIT-licensed verifier for the PSI-SEAL/1 canonical seal schema. Verification is free forever; a seal whose Ed25519 signature was not checked is never reported as a pass, R11.6 makes a signature name the digest it authenticates so the verifier recomputes it instead of trusting a declared value, and R13.1 verifies an RFC 9162 inclusion proof by walking the tree's split rather than the leaf-index parity shortcut.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "node --experimental-strip-types --test test/seal-signature.test.ts test/incident.test.ts test/merkle-profile.test.ts test/inclusion-proof.test.ts",
    "test:cross-language": "python ../psi-verifier-py/tools/cross_language_check.py && node --experimental-strip-types test/cross-language/node_check.mts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "psi",
    "apex",
    "apex-psi",
    "verification",
    "verifier",
    "ai-governance",
    "eu-ai-act",
    "sha256",
    "ed25519",
    "merkle-tree",
    "rfc8785",
    "post-quantum",
    "provenance"
  ],
  "author": "APEX Intelligence Empire / ROCKYFILMS888 PTY LTD (ABN 71 672 237 795)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawal393/APEX-PSI.git",
    "directory": "packages/psi-verifier"
  },
  "bugs": {
    "url": "https://github.com/kawal393/APEX-PSI/issues"
  },
  "homepage": "https://ai-governance-standard.com/license",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "sideEffects": false,
  "bin": {
    "apex-psi-verifier": "dist/cli.js"
  }
}
