# Specification shelf: pin markdown to LF so published digests are
# reproducible on every platform regardless of a client's core.autocrlf.
specs/*.md text eol=lf

# The IETF drafts are published with a recorded sha256 and the promise that a
# stranger can recompute it. Pin them to LF so a Windows checkout does not
# rewrite the line endings and produce a different digest from the served copy.
public/ietf/*.txt text eol=lf
public/ietf/submission/*.txt text eol=lf

# The registry's own copies of the earlier drafts. The audit compares their
# digest with the published one, so a Windows checkout must not rewrite them.
public/ietf/published/*.txt text eol=lf

# The prose sources the drafts are laid out from. The layout is a pure
# function of these files, so their line endings are pinned too.
drafts/ietf/*.txt text eol=lf

# The published vectors are compared byte-for-byte by the generator that writes
# them, and a reader who downloads them from the site gets what the repository
# holds. With core.autocrlf=true a Windows checkout rewrote the committed file to
# CRLF and `npm run check:vectors` then failed on a clean tree — the same commit
# passed on the Linux runner and failed on this machine. Measured 19 Nov 2026.
public/hello-psi/vectors.json text eol=lf

# Shard digests are quoted in manifest.json, so their bytes must not be rewritten.
ledger-shards/*.ndjson text eol=lf
ledger-shards/manifest.json text eol=lf
ledger-shards/README.md text eol=lf
ledger-shards/ROOTS.tsv text eol=lf
